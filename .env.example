# Copy to .env.local for development. Set the same keys in Vercel Project Settings.
# Do not commit real values.

# --- Required (build + runtime) ---
DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=faithconnecthub

# Public origin used for donation return URLs, invites, and emails.
# Production: your custom domain, e.g. https://your-domain.com
# Preview: VERCEL_URL is used as fallback; still set this for a custom domain.
NEXT_PUBLIC_APP_URL=

# --- Optional Clerk URL overrides ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# --- Payments (donations + subscriptions) ---
# Product default is Razorpay when unset. Set explicitly in Vercel.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_PROFESSIONAL_PLAN_ID=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=
SUPER_ADMIN_EMAIL=
CONTACT_EMAIL=

# --- Shepherd AI ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Analytics ---
UMAMI_WEBSITE_ID=

# --- Distributed rate limiting (required in production / Vercel) ---
# Join, contact, donation checkout/verify, Shepherd, and uploads fail closed
# in production if these are missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Cron (trial lifecycle). Set CRON_SECRET; Vercel sends Bearer automatically. ---
CRON_SECRET=
# SKIP_ENV_VALIDATION=true
