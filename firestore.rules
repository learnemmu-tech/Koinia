rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function isPlatformSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "futureblock07@gmail.com" ||
        (userDocExists() && userData().role == "admin")
      );
    }

    function isChurchAdminFor(churchId) {
      return userDocExists() && (
        (userData().churchRole == "admin" && userData().churchId == churchId) ||
        (userData().managedChurchIds is list && churchId in userData().managedChurchIds) ||
        hasActiveBranchAdminForChurch(churchId)
      );
    }

    function canManageChurchContent(churchId) {
      return isPlatformSuperAdmin() || isChurchAdminFor(churchId);
    }

    /** Org staff may manage church content when organizationId is stamped on the document. */
    function canManageChurchContentWithOrg(churchId, organizationId) {
      return canManageChurchContent(churchId)
        || (organizationId is string
          && organizationId.size() > 0
          && isOrgContentManager(organizationId));
    }

    function canManageChurchContentOnCreate() {
      return canManageChurchContentWithOrg(
        request.resource.data.churchId,
        request.resource.data.organizationId
      );
    }

    function canManageChurchContentOnResource() {
      return canManageChurchContentWithOrg(
        resource.data.churchId,
        resource.data.organizationId
      );
    }

    function hasValidChurchId() {
      return request.resource.data.churchId is string
        && request.resource.data.churchId.size() > 0;
    }

    /** Legacy single-tenant installs may use a shared default church id. */
    function isLegacyDefaultChurchId(churchId) {
      return churchId == "default" || churchId == "faithconnecthub";
    }

    function churchIdUnchanged() {
      return request.resource.data.churchId == resource.data.churchId;
    }

    function isValidUserSelfUpdate() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "firstName",
          "lastName",
          "email",
          "emailPreferences",
          "updatedAt"
        ]);
    }

    function activeBranchMembershipData() {
      return get(/databases/$(database)/documents/branchMemberships/$(userData().activeBranchId + '_' + request.auth.uid)).data;
    }

    function branchMembershipCanManageChurch() {
      return activeBranchMembershipData().role in [
        "owner",
        "org_admin",
        "church_admin",
        "branch_admin",
        "leader",
        "editor"
      ];
    }

    function hasActiveBranchAdminForChurch(churchId) {
      return isSignedIn()
        && userDocExists()
        && userData().activeBranchId is string
        && userData().activeBranchId.size() > 0
        && exists(/databases/$(database)/documents/branchMemberships/$(userData().activeBranchId + '_' + request.auth.uid))
        && activeBranchMembershipData().status == "active"
        && activeBranchMembershipData().churchId == churchId
        && branchMembershipCanManageChurch();
    }

    function hasActiveBranchMembershipForChurch(churchId) {
      return isSignedIn()
        && userDocExists()
        && userData().activeBranchId is string
        && userData().activeBranchId.size() > 0
        && exists(/databases/$(database)/documents/branchMemberships/$(userData().activeBranchId + '_' + request.auth.uid))
        && activeBranchMembershipData().status == "active"
        && activeBranchMembershipData().churchId == churchId;
    }

    function optionalOrganizationId(data) {
      return data.organizationId is string ? data.organizationId : "";
    }

    function canReadChurchContent(churchId, organizationId) {
      return isPlatformSuperAdmin()
        || isChurchAdminFor(churchId)
        || (organizationId is string
          && organizationId.size() > 0
          && isOrgContentManager(organizationId))
        || hasActiveBranchMembershipForChurch(churchId);
    }

    function isValidNotificationCreate() {
      return request.resource.data.keys().hasAll([
          "userId",
          "churchId",
          "type",
          "title",
          "message",
          "contentId",
          "createdAt"
        ])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.churchId is string
        && request.resource.data.churchId.size() > 0
        && (
          request.resource.data.userId == request.auth.uid
          || canManageChurchContentWithOrg(
            request.resource.data.churchId,
            optionalOrganizationId(request.resource.data)
          )
        );
    }

    function membershipDocPath(orgId) {
      return /databases/$(database)/documents/memberships/$(orgId + '_' + request.auth.uid);
    }

    function hasActiveMembership(orgId) {
      return isSignedIn()
        && exists(membershipDocPath(orgId))
        && get(membershipDocPath(orgId)).data.status == "active";
    }

    function isOrgAdmin(orgId) {
      return hasActiveMembership(orgId) && (
        get(membershipDocPath(orgId)).data.role == "owner"
        || get(membershipDocPath(orgId)).data.role == "org_admin"
      );
    }

    function isOrgContentManager(orgId) {
      return hasActiveMembership(orgId) && (
        get(membershipDocPath(orgId)).data.role in [
          "owner",
          "org_admin",
          "church_admin",
          "branch_admin",
          "leader",
          "editor"
        ]
      );
    }

    function canManageOrgChurch(orgId) {
      return isPlatformSuperAdmin() || isOrgAdmin(orgId);
    }

    function isValidPrayerRequestCreate() {
      return request.resource.data.keys().hasAll([
        "churchId",
        "userId",
        "name",
        "title",
        "request",
        "isAnonymous",
        "status",
        "prayerCount",
        "createdAt",
        "updatedAt"
      ])
        && request.resource.data.churchId is string
        && (hasValidChurchId() || isLegacyDefaultChurchId(request.resource.data.churchId))
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.title is string
        && request.resource.data.request is string
        && request.resource.data.isAnonymous is bool
        && request.resource.data.status == "pending"
        && request.resource.data.prayerCount == 0
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.request.size() > 0
        && request.resource.data.request.size() <= 1000
        && (!('category' in request.resource.data)
          || request.resource.data.category is string)
        && (!('shareWithCommunity' in request.resource.data)
          || request.resource.data.shareWithCommunity is bool)
        && (!('isAnswered' in request.resource.data)
          || request.resource.data.isAnswered == false);
    }

    function isPrayerRequestOwnerAnswered() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.isAnswered != true
        && request.resource.data.isAnswered == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isAnswered",
          "answeredAt",
          "updatedAt"
        ]);
    }

    function isValidPrayerIntercessionCreate(intercessionId) {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() > 0
        && request.resource.data.keys().hasAll([
          "requestId",
          "userId",
          "createdAt"
        ])
        && intercessionId == request.resource.data.requestId + '_' + request.auth.uid;
    }

    function currentPrayerCount() {
      return resource.data.prayerCount is int
        ? resource.data.prayerCount
        : (resource.data.prayerCount is float
          ? int(resource.data.prayerCount)
          : 0);
    }

    function isPrayerCountIncrement() {
      return isSignedIn()
        && resource.data.status == "approved"
        && request.resource.data.status == "approved"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "prayerCount",
          "updatedAt"
        ])
        && request.resource.data.prayerCount is int
        && request.resource.data.prayerCount == currentPrayerCount() + 1;
    }

    function isPrayerCountDecrement() {
      return isSignedIn()
        && resource.data.status == "approved"
        && request.resource.data.status == "approved"
        && currentPrayerCount() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "prayerCount",
          "updatedAt"
        ])
        && request.resource.data.prayerCount == currentPrayerCount() - 1;
    }

    function isSongPlayCountIncrement() {
      return isSignedIn()
        && churchIdUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["playCount"])
        && request.resource.data.playCount
          == (resource.data.playCount is int ? resource.data.playCount + 1 : 1);
    }

    match /churches/{churchId} {
      allow read: if resource.data.isActive == true || isPlatformSuperAdmin();
      allow create: if isPlatformSuperAdmin()
        || (request.resource.data.organizationId is string
          && canManageOrgChurch(request.resource.data.organizationId));
      allow update, delete: if isPlatformSuperAdmin()
        || (resource.data.organizationId is string
          && canManageOrgChurch(resource.data.organizationId));
    }

    match /organizations/{organizationId} {
      allow read: if isPlatformSuperAdmin() || hasActiveMembership(organizationId);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isPlatformSuperAdmin() || isOrgAdmin(organizationId);
      allow delete: if isPlatformSuperAdmin();
    }

    match /memberships/{membershipId} {
      allow read: if isPlatformSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (resource.data.organizationId is string
          && isOrgAdmin(resource.data.organizationId));
      allow create, update, delete: if false;
    }

    match /branches/{branchId} {
      allow read: if isPlatformSuperAdmin()
        || (resource.data.organizationId is string
          && hasActiveMembership(resource.data.organizationId));
      allow create: if isPlatformSuperAdmin()
        || (request.resource.data.organizationId is string
          && canManageOrgChurch(request.resource.data.organizationId));
      allow update, delete: if isPlatformSuperAdmin()
        || (resource.data.organizationId is string
          && canManageOrgChurch(resource.data.organizationId));
    }

    match /branchMemberships/{branchMembershipId} {
      allow read: if isPlatformSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (resource.data.organizationId is string
          && isOrgAdmin(resource.data.organizationId))
        || (resource.data.churchId is string
          && canManageChurchContentWithOrg(
            resource.data.churchId,
            optionalOrganizationId(resource.data)
          ));
      allow create, update, delete: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isPlatformSuperAdmin()
        || (resource.data.organizationId is string
          && isOrgAdmin(resource.data.organizationId));
      allow create, update, delete: if false;
    }

    match /songs/{songId} {
      allow read: if canReadChurchContent(
        resource.data.churchId,
        optionalOrganizationId(resource.data)
      );
      allow create: if canManageChurchContentOnCreate() && hasValidChurchId();
      allow update: if (canManageChurchContentOnResource() && churchIdUnchanged())
        || isSongPlayCountIncrement();
      allow delete: if canManageChurchContentOnResource();
    }

    match /sermons/{sermonId} {
      allow read: if canReadChurchContent(
        resource.data.churchId,
        optionalOrganizationId(resource.data)
      );
      allow create: if canManageChurchContentOnCreate() && hasValidChurchId();
      allow update: if canManageChurchContentOnResource() && churchIdUnchanged();
      allow delete: if canManageChurchContentOnResource();
    }

    match /ceremonies/{sermonId} {
      allow read: if canReadChurchContent(
        resource.data.churchId,
        optionalOrganizationId(resource.data)
      );
      allow create: if canManageChurchContentOnCreate() && hasValidChurchId();
      allow update: if canManageChurchContentOnResource() && churchIdUnchanged();
      allow delete: if canManageChurchContentOnResource();
    }

    match /articles/{articleId} {
      allow read: if canReadChurchContent(
        resource.data.churchId,
        optionalOrganizationId(resource.data)
      );
      allow create: if canManageChurchContentOnCreate() && hasValidChurchId();
      allow update: if canManageChurchContentOnResource() && churchIdUnchanged();
      allow delete: if canManageChurchContentOnResource();
    }

    match /events/{eventId} {
      allow read: if resource.data.status == "published" || isPlatformSuperAdmin() || isChurchAdminFor(resource.data.churchId)
        || (resource.data.organizationId is string && isOrgAdmin(resource.data.organizationId));
      allow create: if canManageChurchContentOnCreate() && hasValidChurchId();
      allow update: if canManageChurchContentOnResource() && churchIdUnchanged();
      allow delete: if canManageChurchContentOnResource();
    }

    match /eventRegistrations/{registrationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /donationCampaigns/{campaignId} {
      allow read: if isPlatformSuperAdmin()
        || isChurchAdminFor(resource.data.churchId)
        || resource.data.status == "active"
        || (resource.data.organizationId is string
          && isOrgAdmin(resource.data.organizationId));
      allow create: if canManageChurchContentOnCreate() && hasValidChurchId();
      allow update: if canManageChurchContentOnResource() && churchIdUnchanged();
      allow delete: if canManageChurchContentOnResource();
    }

    match /donations/{donationId} {
      allow read: if isPlatformSuperAdmin()
        || isChurchAdminFor(resource.data.churchId)
        || (resource.data.organizationId is string
          && isOrgAdmin(resource.data.organizationId))
        || (isSignedIn()
          && request.auth.token.email != null
          && resource.data.donorEmail == request.auth.token.email);
      allow create, update, delete: if false;
    }

    match /recentlyViewed/{recentlyViewedId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid
        || isPlatformSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemType in ["song", "sermon", "article"]
        && request.resource.data.keys().hasAll([
          "userId",
          "itemId",
          "itemType",
          "viewedAt"
        ]);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedAt"]);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /prayerRequests/{requestId} {
      allow read: if resource.data.status == "approved"
        || isPlatformSuperAdmin()
        || isChurchAdminFor(resource.data.churchId)
        || (resource.data.organizationId is string
          && resource.data.organizationId.size() > 0
          && isOrgAdmin(resource.data.organizationId))
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && isValidPrayerRequestCreate();
      allow update: if isPlatformSuperAdmin()
        || isChurchAdminFor(resource.data.churchId)
        || (resource.data.organizationId is string
          && resource.data.organizationId.size() > 0
          && isOrgAdmin(resource.data.organizationId))
        || isPrayerCountIncrement()
        || isPrayerCountDecrement()
        || isPrayerRequestOwnerAnswered();
      allow delete: if isPlatformSuperAdmin()
        || isChurchAdminFor(resource.data.churchId)
        || (resource.data.organizationId is string
          && resource.data.organizationId.size() > 0
          && isOrgAdmin(resource.data.organizationId));
    }

    match /prayerIntercessions/{intercessionId} {
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.userId == request.auth.uid
        || isPlatformSuperAdmin()
      );
      allow create: if isValidPrayerIntercessionCreate(intercessionId);
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isPlatformSuperAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidNotificationCreate();
      allow update, delete: if false;
    }

    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid
        || isPlatformSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemType in ["song", "sermon", "article", "event"]
        && request.resource.data.keys().hasAll([
          "userId",
          "itemId",
          "itemType",
          "createdAt"
        ]);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /users/{userId}/notificationReads/{readId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId
        || isPlatformSuperAdmin()
        || (userDocExists()
          && resource.data.churchId is string
          && isChurchAdminFor(resource.data.churchId));
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user";
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidUserSelfUpdate();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isPlatformSuperAdmin()
        || hasActiveMembership(subscriptionId)
        || isChurchAdminFor(subscriptionId)
        || (userDocExists() && userData().organizationId == subscriptionId);
      allow create, update, delete: if isPlatformSuperAdmin()
        || isOrgAdmin(subscriptionId);
    }
  }
}
