# Copy to .env and fill in values.

# PostgreSQL (server-only)
DATABASE_URL=

# Clerk (identity only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Multi-Church (Tenant)
# DEFAULT_CHURCH_ID=
# NEXT_PUBLIC_DEFAULT_CHURCH_ID=

# Analytics (optional)
# UMAMI_WEBSITE_ID=

# Payments (donations and subscriptions)
# PAYMENT_PROVIDER=stripe
# NEXT_PUBLIC_APP_URL=https://faithconnecthub.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxxx
# RAZORPAY_SECRET_KEY=
# Required for subscription webhooks. Configure the same secret on the Razorpay
# Dashboard webhook pointing at /api/webhooks/razorpay. Subscribe at least to:
# subscription.authenticated, subscription.activated, subscription.pending,
# subscription.halted, subscription.cancelled, payment.failed, payment.captured
# (payment.captured is also used by the separate donation Order flow).
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_STARTER_PLAN_ID=
# Required to offer Professional checkout. Leave unset to fail closed with a
# configuration error instead of opening Checkout.
# RAZORPAY_PROFESSIONAL_PLAN_ID=
# RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=1200

# Email (Resend)
# RESEND_API_KEY=
RESEND_FROM_EMAIL=FaithConnectHub <notifications@futureblock.in>
# RESEND_REPLY_TO=you@example.com
# ADMIN_NOTIFICATION_EMAIL=admin@example.com
# CRON_SECRET=replace-with-a-long-random-string
# CONTACT_EMAIL=contact@futureblock.in

# Application URL
# NEXT_PUBLIC_APP_URL=https://your-production-domain
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform (optional)
# SUPER_ADMIN_EMAIL=admin@your-domain.com

# Shepherd AI (server-only)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Supabase Storage (server-only)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=faithconnecthub

# Distributed rate limiting (required in production / Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Required core: DATABASE_URL, Clerk keys, Supabase settings,
# NEXT_PUBLIC_APP_URL, and UPSTASH_REDIS_* in production.
# Required for donations: PAYMENT_PROVIDER plus Stripe or Razorpay settings.
# Required for subscriptions: Razorpay Test keys, RAZORPAY_WEBHOOK_SECRET,
# RAZORPAY_STARTER_PLAN_ID, and RAZORPAY_PROFESSIONAL_PLAN_ID when Professional
# checkout is offered.
