# Copy to .env and fill in values.

# ── PostgreSQL (server-only) ──────────────────────────────────────────────────
# Never expose DATABASE_URL to the browser. Do not prefix with NEXT_PUBLIC_.
# Example: postgresql://USER:PASSWORD@HOST:5432/faithconnecthub
# Neon: prefer the POOLED connection string (-pooler hostname). Direct
# endpoints make local/dev request fan-out slow and exhaust connections.
# Neon / hosted Postgres: use sslmode=verify-full (not sslmode=require).
# node-postgres treats require as verify-full today and will warn otherwise.
# Percent-encode special characters in the password so Next.js does not expand them
# (for example $ → %24). Do not commit real credentials.
 
DATABASE_URL=

# ── Clerk (identity only — do not enable Clerk Organizations) ────────────────
# Dashboard → API Keys. Custom sign-in/sign-up pages are /signin and /signup.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Recommended: disable "Verify at sign-up" so users get a session immediately
# (email verification remains available via the existing banner).

# ── Multi-Church (Tenant) ───────────────────────────────────────────────────
# Set to your primary church document ID after creating the first church.
# Legacy content without churchId is attributed to this ID during reads.
# DEFAULT_CHURCH_ID=
# NEXT_PUBLIC_DEFAULT_CHURCH_ID=

# ── Analytics (optional) ──────────────────────────────────────────────────────
# UMAMI_WEBSITE_ID=

# ── Payments (Donations) ────────────────────────────────────────────────────
# PAYMENT_PROVIDER=stripe
# Required in production for donation success/cancel URLs (no Host-header fallback):
# NEXT_PUBLIC_APP_URL=https://faithconnecthub.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ── Email (Resend) ───────────────────────────────────────────────────────────
# Put your real key only in .env (never commit it).
# RESEND_API_KEY=re_xxxxxxxx
#
# FROM address — must be verified in Resend (see note below).
# Local testing with onboarding@resend.dev:
#   - Emails can ONLY be delivered to the email on your Resend account.
#   - Set ADMIN_NOTIFICATION_EMAIL to that same address while testing.
# RESEND_FROM_EMAIL=FaithConnectHub <onboarding@resend.dev>
#
# REPLY_TO can be any valid inbox (does not affect Resend delivery rules):
# RESEND_REPLY_TO=you@example.com
# ADMIN_NOTIFICATION_EMAIL=you@example.com
# Required for Contact Us. If unset, ADMIN_NOTIFICATION_EMAIL is used as fallback.
# CONTACT_EMAIL=contact@your-domain.com
#
# Must include protocol for correct email / donation redirect links.
# Production: https://your-production-domain (never localhost).
# NEXT_PUBLIC_APP_URL=https://faithconnecthub.com

# Local only:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Platform (optional) ─────────────────────────────────────────────────────
# Bootstrap only: Clerk-verified primary email matching this value is
# promoted once to users.platform_role = super_admin. Authorization then
# uses PostgreSQL, not this email.
# SUPER_ADMIN_EMAIL=admin@your-domain.com

# ── Shepherd AI (server-only — never prefix with NEXT_PUBLIC_) ─────────────
# Google Gemini provider. Put the real key only in .env / .env.local (never commit it).
# GEMINI_API_KEY=
# Optional override (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# ── Supabase Storage (server-only — never prefix with NEXT_PUBLIC_) ─────────
# Object storage only. Do not use Supabase Auth or Supabase Database.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=faithconnecthub
#
# ── Distributed rate limiting (REQUIRED in production / Vercel) ────────────
# Production fail-closed: without these, rate-limited endpoints return 429.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Covers: contact, join, shepherd, donation checkout, uploads.
#
# Shorts videos are compressed client-side to fit the 50 MB Supabase Free upload limit.
# Users may select sources up to 400 MB; larger files are re-encoded in the browser before upload.

# ── Production checklist (do not commit real values) ───────────────────────
# Required core: DATABASE_URL (Neon pooled), CLERK_SECRET_KEY,
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY,
#   SUPABASE_STORAGE_BUCKET, NEXT_PUBLIC_APP_URL, UPSTASH_REDIS_*
# Required for donations: PAYMENT_PROVIDER + Stripe OR Razorpay secrets + webhook secrets
# Required for Shepherd: GEMINI_API_KEY (GEMINI_MODEL optional)
# Optional: RESEND_*, SUPER_ADMIN_EMAIL, ADMIN_NOTIFICATION_EMAIL, CONTACT_EMAIL
# Obsolete (do not set for this app): NEXT_PUBLIC_FIREBASE_*, FIREBASE_*
